{
  "name": "dygoframework-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "dev": "INCLUDE_DEV_PAGES=true astro dev",
    "build": "astro build --force",
    "build:test": "INCLUDE_DEV_PAGES=true npm run build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "stylelint \"src/**/*.{css,astro}\" && node scripts/check-design.mjs",
    "test:unit": "node --test \"scripts/**/*.test.mjs\"",
    "test:visual": "node scripts/playwright.mjs visual",
    "test:a11y": "node scripts/playwright.mjs a11y",
    "test:baselines": "node scripts/playwright.mjs visual --update-snapshots",
    "test": "npm run test:unit && npm run test:a11y && npm run test:visual",
    "test:cover": "node --test --experimental-test-coverage \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.8",
    "@fontsource/fira-mono": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "postcss-html": "2.0.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
