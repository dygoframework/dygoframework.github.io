---
// The page title, with "On this page" folded above the article below 1024px.
import OnThisPage from '../navigation/OnThisPage.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const { toc, entry, id } = Astro.locals.starlightRoute;
const markdownUrl = `/${id === 'docs' ? 'docs' : id}.md`;
const headings = toc?.items.flatMap((item) => [item, ...item.children]).filter((h) => h.slug !== '_top') ?? [];
---

<div class="dy-title">
	<h1 class="dy-title__heading" id="_top">{entry.data.title}</h1>
	<Button variant="tool" data-copy-markdown={markdownUrl}>
		<Icon name="copy" size="sm" />
		<span data-copy-label>Copy markdown</span>
	</Button>
</div>
{
	headings.length > 0 && (
		<div class="dy-title__toc">
			<OnThisPage variant="collapsible" title={entry.data.title} headings={headings} id="dy-on-this-page-mobile" />
		</div>
	)
}

<script>
	document.addEventListener('click', async (event) => {
		const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-copy-markdown]');
		const label = button?.querySelector('[data-copy-label]');
		if (!button || !label) return;
		try {
			const response = await fetch(button.dataset.copyMarkdown ?? '');
			if (!response.ok) throw new Error(String(response.status));
			await navigator.clipboard.writeText(await response.text());
			label.textContent = 'Copied';
		} catch {
			label.textContent = 'Copy failed';
		}
		setTimeout(() => (label.textContent = 'Copy markdown'), 2000);
	});
</script>

<style>
	.dy-title {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--dy-space-3) var(--dy-space-6);
	}

	.dy-title__heading {
		margin: 0;
		color: var(--dy-color-text);
		font-size: var(--dy-text-display-docs);
		font-weight: var(--dy-weight-bold);
		line-height: var(--dy-leading-heading);
		letter-spacing: var(--dy-tracking-heading);
	}

	.dy-title__toc {
		margin-top: var(--dy-space-5);
	}

	@media (width >= 1024px) {
		.dy-title__toc {
			display: none;
		}
	}
</style>
