---
// The footer of Home (full) and Enterprise (simple).
import { footerNav, license, mainNav } from '../../data/navigation';

interface Props {
	variant?: 'full' | 'simple';
	/** simple only: adds the license and a top border, as on Start a project. */
	license?: boolean;
}

const { variant = 'full', license: showLicense = false } = Astro.props;
const year = 2026;
---

<footer class:list={['dy-footer', `dy-footer--${variant}`, showLicense && 'dy-footer--license']}>
	<div class="dy-footer__inner">
		{
			variant === 'full' ? (
				<>
					<div class="dy-footer__grid">
						<div class="dy-footer__brand">
							<span class="dy-footer__name">
								<svg class="dy-footer__mark" viewBox="0 0 64 64" aria-hidden="true">
									<path d="M32 3L57 11V31C57 45 47 55 32 61C17 55 7 45 7 31V11ZM23 17L36 32L23 47H34L47 32L34 17Z" fill="currentColor" fill-rule="evenodd" />
								</svg>
								Dygo
							</span>
							<span class="dy-footer__muted dy-footer__site">www.dygoframework.com</span>
						</div>
						{footerNav.map((group) => (
							<nav class:list={['dy-footer__group', group.desktopOnly && 'dy-footer__desktop']} aria-label={group.title}>
								<strong>{group.title}</strong>
								{group.links.map((link) => (
									<a class:list={['dy-footer__muted', link.mobileOnly && 'dy-footer__mobile']} href={link.href}>
										{link.label}
									</a>
								))}
							</nav>
						))}
					</div>
					<p class="dy-footer__copy">© {year} Dygo Framework · {license} license</p>
				</>
			) : (
				<>
					<span>© {year} Dygo Framework{showLicense && ` · ${license} license`}</span>
					<nav class="dy-footer__row" aria-label="Footer">
						{mainNav.filter((link) => link.key !== 'start').map((link) => (
							<a href={link.href}>{link.label === 'Docs' ? 'Documentation' : link.label}</a>
						))}
					</nav>
				</>
			)
		}
	</div>
</footer>

<style>
	.dy-footer__inner {
		box-sizing: border-box;
		max-width: var(--dy-width-content);
		margin: 0 auto;
		padding: var(--dy-space-12) var(--dy-space-5) var(--dy-space-8);
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-8);
	}

	.dy-footer--full {
		border-top: var(--dy-border-width) solid var(--dy-color-border);
	}

	.dy-footer--full .dy-footer__inner {
		padding: var(--dy-space-10) var(--dy-space-5) var(--dy-space-8);
		gap: var(--dy-space-7);
	}

	.dy-footer__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--dy-space-6);
	}

	.dy-footer__brand {
		grid-column: 1 / -1;
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-1);
	}

	.dy-footer__name {
		display: flex;
		align-items: center;
		gap: var(--dy-space-2-5);
		font-size: var(--dy-text-2xl);
		font-weight: var(--dy-weight-extrabold);
	}

	.dy-footer__mark {
		width: var(--dy-size-icon-lg);
		height: var(--dy-size-icon-lg);
		color: var(--dy-color-accent);
	}

	.dy-footer__site,
	.dy-footer__desktop {
		display: none;
	}

	.dy-footer__group,
	.dy-footer__group.dy-footer__desktop {
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-2);
	}

	.dy-footer__group.dy-footer__desktop {
		display: none;
	}

	.dy-footer__muted {
		color: var(--dy-color-text-muted);
	}

	.dy-footer__copy {
		margin: 0;
		padding-top: var(--dy-space-5);
		border-top: var(--dy-border-width) solid var(--dy-color-border);
		color: var(--dy-color-text-muted);
		font-size: var(--dy-text-sm);
	}

	.dy-footer--simple .dy-footer__inner {
		flex-flow: row wrap;
		justify-content: space-between;
		gap: var(--dy-space-4) var(--dy-space-8);
		color: var(--dy-color-text-muted);
		font-size: var(--dy-text-md);
	}

	.dy-footer--license {
		border-top: var(--dy-border-width) solid var(--dy-color-border);
	}

	.dy-footer__row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--dy-space-2) var(--dy-space-6);
	}

	@media (width >= 1024px) {
		.dy-footer__inner {
			padding: var(--dy-space-18) var(--dy-space-8) var(--dy-space-10);
			gap: var(--dy-space-14);
		}

		.dy-footer--simple .dy-footer__inner {
			padding: var(--dy-space-14) var(--dy-space-8) var(--dy-space-10);
		}

		.dy-footer--license .dy-footer__inner {
			padding: var(--dy-space-10) var(--dy-space-8);
		}

		.dy-footer--full .dy-footer__inner {
			padding: var(--dy-space-16) var(--dy-space-8) var(--dy-space-10);
			gap: var(--dy-space-12);
		}

		.dy-footer--full .dy-footer__copy {
			padding-top: var(--dy-space-6);
		}

		.dy-footer__grid {
			grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
			gap: var(--dy-space-8);
		}

		.dy-footer__brand {
			grid-column: auto;
			gap: var(--dy-space-2);
		}

		.dy-footer__name {
			font-size: var(--dy-text-stat-mobile);
		}

		.dy-footer__mark {
			width: var(--dy-space-7);
			height: var(--dy-space-7);
		}

		.dy-footer__site {
			display: inline;
		}

		.dy-footer__group,
		.dy-footer__group.dy-footer__desktop {
			display: flex;
			gap: var(--dy-space-2-5);
		}

		.dy-footer__mobile {
			display: none;
		}
	}
</style>
