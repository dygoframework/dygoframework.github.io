---
// The Enterprise contact form. GitHub Pages can't take form posts, so it
// sends JSON to PUBLIC_CONTACT_FORM_URL (a form service such as Formspree).
// It shows success only when that request succeeds.
import Button from '../ui/Button.astro';
import Input from '../ui/Input.astro';

interface Props {
	title: string;
	lead: string;
	privacy: string;
	success: string;
	error: string;
	endpoint?: string;
}

const { title, lead, privacy, success, error, endpoint } = Astro.props;
---

<section class="dy-contact" id="contact">
	<div class="dy-contact__inner">
		<h2 class="dy-contact__title">{title}</h2>
		<p class="dy-contact__lead">{lead}</p>
		<form class="dy-contact__form" data-contact-form data-endpoint={endpoint ?? ''} data-error={error} novalidate>
			<Input
				class="dy-contact__field"
				id="contact-email"
				name="email"
				type="email"
				label="Work email"
				placeholder="you@company.com"
				autocomplete="email"
				required
			/>
			<div class="dy-visually-hidden" aria-hidden="true">
				<label for="contact-company">Leave this empty</label>
				<input id="contact-company" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
			</div>
			<Button type="submit" shape="rounded" class="dy-contact__submit" data-submit>Get in touch</Button>
		</form>
		<p class="dy-contact__privacy">{privacy}</p>
		<p class="dy-contact__success" role="status" data-success hidden>{success}</p>
		<p class="dy-contact__error" role="alert" data-error-message hidden></p>
	</div>
</section>

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>('[data-contact-form]')) {
		const section = form.closest('section');
		const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
		const email = form.querySelector<HTMLInputElement>('input[name="email"]');
		const success = section?.querySelector<HTMLElement>('[data-success]');
		const failure = section?.querySelector<HTMLElement>('[data-error-message]');
		const label = submit?.textContent ?? '';

		const showError = (message: string) => {
			if (failure) {
				failure.textContent = message;
				failure.hidden = false;
			}
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (!submit || !email || !success || !failure) return;
			failure.hidden = true;
			if (!email.checkValidity()) {
				email.setAttribute('aria-invalid', 'true');
				showError('Enter a valid work email address.');
				email.focus();
				return;
			}
			email.removeAttribute('aria-invalid');
			const data = new FormData(form);
			// Bots fill the hidden field. Don't send, and don't claim success.
			if (data.get('_gotcha')) return showError(form.dataset.error ?? '');
			if (!form.dataset.endpoint) return showError(form.dataset.error ?? '');

			submit.disabled = true;
			submit.setAttribute('aria-busy', 'true');
			submit.textContent = 'Sending';
			try {
				const response = await fetch(form.dataset.endpoint, {
					method: 'POST',
					headers: { 'content-type': 'application/json', accept: 'application/json' },
					body: JSON.stringify({ email: data.get('email') }),
				});
				if (!response.ok) throw new Error(String(response.status));
				form.hidden = true;
				success.hidden = false;
			} catch {
				showError(form.dataset.error ?? '');
			} finally {
				submit.disabled = false;
				submit.removeAttribute('aria-busy');
				submit.textContent = label;
			}
		});
	}
</script>

<style>
	.dy-contact {
		background: var(--dy-color-surface);
		border-block: var(--dy-border-width) solid var(--dy-color-border);
	}

	.dy-contact__inner {
		box-sizing: border-box;
		max-width: var(--dy-width-contact);
		margin: 0 auto;
		padding: var(--dy-space-14) var(--dy-space-5);
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-5);
	}

	.dy-contact__title {
		margin: 0;
		font-size: var(--dy-text-cta-mobile);
		font-weight: var(--dy-weight-extrabold);
		line-height: var(--dy-leading-title);
	}

	.dy-contact__lead {
		margin: 0;
		color: var(--dy-color-text-muted);
		font-size: var(--dy-text-lg);
	}

	.dy-contact__form {
		width: 100%;
		max-width: var(--dy-width-form);
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-3);
		text-align: left;
	}

	.dy-contact__form[hidden] {
		display: none;
	}

	.dy-contact__privacy {
		margin: 0;
		color: var(--dy-color-text-muted);
		font-size: var(--dy-text-sm);
	}

	.dy-contact__success,
	.dy-contact__error {
		margin: 0;
		font-weight: var(--dy-weight-semibold);
	}

	.dy-contact__success[hidden],
	.dy-contact__error[hidden] {
		display: none;
	}

	@media (width >= 1024px) {
		.dy-contact__inner {
			padding: var(--dy-space-24) var(--dy-space-8);
			align-items: center;
			text-align: center;
		}

		.dy-contact__title {
			font-size: var(--dy-text-display-contact);
		}

		.dy-contact__lead {
			font-size: var(--dy-text-xl);
		}

		.dy-contact__form {
			flex-flow: row wrap;
			align-items: flex-end;
		}

		.dy-contact__form :global(.dy-contact__field) {
			flex: 1 1 300px;
		}
	}
</style>
