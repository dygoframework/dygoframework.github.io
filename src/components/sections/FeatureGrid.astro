---
// A heading and a grid of feature cards divided by hairlines. tiles: rounded
// cards with gaps, as on Home.
import Card from '../ui/Card.astro';

interface Props {
	title: string;
	lead?: string;
	items: { title: string; description: string; short?: string; badge?: string }[];
	variant?: 'lines' | 'tiles';
}

const { title, lead, items, variant = 'lines' } = Astro.props;
---

<section class:list={['dy-features', `dy-features--${variant}`]}>
	<div class="dy-features__inner">
		<div class="dy-features__intro">
			<h2 class="dy-features__title">{title}</h2>
			{lead && <p class="dy-features__lead">{lead}</p>}
		</div>
		<div class="dy-features__grid">
			{items.map((item) => (
				<Card variant={variant === 'tiles' ? 'tile' : 'feature'} title={item.title} description={item.description} short={item.short} badge={item.badge} />
			))}
		</div>
	</div>
</section>

<style>
	.dy-features__inner {
		box-sizing: border-box;
		max-width: var(--dy-width-content);
		margin: 0 auto;
		padding: var(--dy-space-14) var(--dy-space-5);
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-7);
	}

	.dy-features__intro {
		max-width: var(--dy-width-heading);
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-4);
	}

	.dy-features__title {
		margin: 0;
		font-size: var(--dy-text-heading-mobile);
		font-weight: var(--dy-weight-bold);
		line-height: var(--dy-leading-heading);
	}

	.dy-features__lead {
		margin: 0;
		color: var(--dy-color-text-muted);
		font-size: var(--dy-text-xl);
	}

	.dy-features__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
		gap: var(--dy-border-width);
		background: var(--dy-color-border);
		border: var(--dy-border-width) solid var(--dy-color-border);
	}

	.dy-features--tiles .dy-features__inner {
		gap: var(--dy-space-5);
	}

	.dy-features--tiles .dy-features__title {
		font-weight: var(--dy-weight-extrabold);
		line-height: var(--dy-leading-title);
		letter-spacing: var(--dy-tracking-display);
	}

	.dy-features--tiles .dy-features__grid {
		gap: var(--dy-space-3);
		background: none;
		border: 0;
	}

	@media (width >= 1024px) {
		.dy-features--tiles .dy-features__inner {
			gap: var(--dy-space-12);
		}

		.dy-features--tiles .dy-features__title {
			max-width: 780px;
			line-height: var(--dy-leading-section);
		}

		.dy-features--tiles .dy-features__grid {
			grid-template-columns: repeat(auto-fit, minmax(min(270px, 100%), 1fr));
			gap: var(--dy-space-4);
		}

		.dy-features__inner {
			padding: var(--dy-space-26) var(--dy-space-8);
			gap: var(--dy-space-14);
		}

		.dy-features__title {
			font-size: var(--dy-text-display-md);
			line-height: var(--dy-leading-title);
		}
	}
</style>
