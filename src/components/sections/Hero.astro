---
// The dotted hero at the top of pages. Centered from 1024px, left aligned
// with stacked actions below it. split: Home, with a pill above the heading
// and the default slot (the install terminal) beside the text from 1024px.
interface Props {
	eyebrow?: string;
	lead?: string;
	/** A shorter lead for below 1024px. */
	leadShort?: string;
	size?: 'home' | 'enterprise' | 'split';
}

const { eyebrow, lead, leadShort, size = 'home' } = Astro.props;
---

<section class:list={['dy-hero', `dy-hero--${size}`]}>
	<div class="dy-hero__inner">
		<div class="dy-hero__main">
			<slot name="pill" />
			{eyebrow && <p class="dy-hero__eyebrow">{eyebrow}</p>}
			<h1 class="dy-hero__title"><slot name="title" /></h1>
			{
				lead && (
					<p class="dy-hero__lead">
						{leadShort ? (
							<>
								<span class="dy-hero__long">{lead}</span>
								<span class="dy-hero__short">{leadShort}</span>
							</>
						) : (
							lead
						)}
					</p>
				)
			}
			<div class="dy-hero__actions"><slot name="actions" /></div>
		</div>
		<slot />
	</div>
</section>

<style>
	.dy-hero {
		background-image: radial-gradient(var(--dy-color-border) 1px, transparent 1px);
		background-size: var(--dy-dot-grid) var(--dy-dot-grid);
	}

	.dy-hero__inner {
		box-sizing: border-box;
		max-width: var(--dy-width-content);
		margin: 0 auto;
		padding: var(--dy-space-14) var(--dy-space-5) var(--dy-space-14);
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-6);
	}

	.dy-hero__main {
		display: contents;
	}

	.dy-hero__long {
		display: none;
	}

	.dy-hero--split {
		background-image: radial-gradient(var(--dy-color-dot) 1px, transparent 1px);
	}

	.dy-hero--split .dy-hero__inner {
		padding: var(--dy-space-12) var(--dy-space-5) var(--dy-space-10);
		align-items: flex-start;
		gap: var(--dy-space-5-5);
	}

	.dy-hero--split .dy-hero__title {
		line-height: var(--dy-leading-hero);
		letter-spacing: var(--dy-tracking-hero);
	}

	.dy-hero--split .dy-hero__lead {
		font-size: var(--dy-text-lead-mobile);
	}

	.dy-hero--split .dy-hero__actions {
		align-self: stretch;
		gap: var(--dy-space-2-5);
	}

	.dy-hero--split .dy-hero__actions > :global(*) {
		padding-inline: var(--dy-space-5);
	}

	.dy-hero__eyebrow {
		margin: 0;
		color: var(--dy-color-accent);
		font-family: var(--dy-font-mono);
		font-size: var(--dy-text-sm);
	}

	.dy-hero__title {
		margin: 0;
		font-size: var(--dy-text-hero-mobile);
		font-weight: var(--dy-weight-extrabold);
		line-height: var(--dy-leading-display);
		letter-spacing: var(--dy-tracking-display);
	}

	.dy-hero--enterprise .dy-hero__title {
		font-size: var(--dy-text-enterprise-mobile);
	}

	.dy-hero__title :global(.dy-hero__accent) {
		color: var(--dy-color-accent);
	}

	.dy-hero__lead {
		margin: 0;
		max-width: var(--dy-width-prose);
		color: var(--dy-color-text-muted);
		font-size: var(--dy-text-lg);
		text-wrap: pretty;
	}

	.dy-hero__actions {
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-3);
	}

	.dy-hero__actions:empty {
		display: none;
	}

	@media (width >= 1024px) {
		.dy-hero__inner {
			padding: var(--dy-space-28) var(--dy-space-8) var(--dy-space-26);
			align-items: center;
			gap: var(--dy-space-8);
			text-align: center;
		}

		.dy-hero--enterprise .dy-hero__inner {
			max-width: var(--dy-width-hero);
			gap: var(--dy-space-7);
		}

		.dy-hero__title {
			font-size: var(--dy-text-display-hero);
		}

		.dy-hero--enterprise .dy-hero__title {
			font-size: var(--dy-text-display-enterprise);
		}

		.dy-hero__lead {
			font-size: var(--dy-text-xl);
		}

		.dy-hero__long {
			display: inline;
		}

		.dy-hero__short {
			display: none;
		}

		.dy-hero__actions {
			flex-flow: row wrap;
			justify-content: center;
			gap: var(--dy-space-4);
		}

		.dy-hero--split .dy-hero__inner {
			flex-flow: row wrap;
			align-items: center;
			gap: var(--dy-space-14) var(--dy-space-16);
			padding: var(--dy-space-22) var(--dy-space-8) var(--dy-space-24);
			text-align: left;
		}

		.dy-hero--split .dy-hero__main {
			flex: 1 1 520px;
			min-width: 0;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			gap: var(--dy-space-7);
		}

		.dy-hero--split .dy-hero__main + :global(*) {
			flex: 1 1 440px;
			min-width: 0;
		}

		.dy-hero--split .dy-hero__title {
			font-size: var(--dy-text-display-home);
		}

		.dy-hero--split .dy-hero__lead {
			max-width: var(--dy-width-lead);
			font-size: var(--dy-text-xl);
		}

		.dy-hero--split .dy-hero__actions {
			align-self: auto;
			justify-content: flex-start;
			gap: var(--dy-space-3);
		}

		.dy-hero--split .dy-hero__actions > :global(*) {
			padding-inline: var(--dy-space-7);
		}
	}
</style>
