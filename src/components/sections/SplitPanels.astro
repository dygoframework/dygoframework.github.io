---
// Two side-by-side panels with yellow headings: the risk and speed panels on
// Enterprise, and Security and Performance on Home (`cards`: rounded cards,
// with a `short` lead and no link below 1024px). They stack below 1024px.
interface Panel {
	id: string;
	title: string;
	lead: string;
	short?: string;
	items?: string[];
	link?: { label: string; href: string };
}

interface Props {
	label: string;
	panels: Panel[];
	size?: 'large' | 'small' | 'cards';
}

const { label, panels, size = 'large' } = Astro.props;
---

<section class:list={['dy-panels', `dy-panels--${size}`]} aria-label={label}>
	<div class="dy-panels__inner">
	{
		panels.map((panel) => (
			<div class="dy-panels__panel" id={panel.id}>
				<h2 class="dy-panels__title">{panel.title}</h2>
				<p class="dy-panels__lead">
					{panel.short ? (
						<>
							<span class="dy-panels__long">{panel.lead}</span>
							<span class="dy-panels__short">{panel.short}</span>
						</>
					) : (
						panel.lead
					)}
				</p>
				{panel.items && (
					<ul class="dy-panels__list">
						{panel.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				)}
				{panel.link && (
					<a class="dy-panels__link" href={panel.link.href}>
						{panel.link.label}
					</a>
				)}
			</div>
		))
	}
	</div>
</section>

<style>
	.dy-panels {
		border-top: var(--dy-border-width) solid var(--dy-color-border);
	}

	.dy-panels__inner {
		display: grid;
	}

	.dy-panels__long {
		display: none;
	}

	.dy-panels__panel {
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-5);
		padding: var(--dy-space-12) var(--dy-space-5);
	}

	.dy-panels__panel + .dy-panels__panel {
		background: var(--dy-color-surface-code);
	}

	.dy-panels__title {
		margin: 0;
		color: var(--dy-color-accent);
		font-size: var(--dy-text-panel-mobile);
		font-weight: var(--dy-weight-extrabold);
		line-height: var(--dy-leading-title);
	}

	.dy-panels--small .dy-panels__title {
		font-size: var(--dy-text-panel-sm-mobile);
	}

	.dy-panels__lead {
		margin: 0;
		color: var(--dy-color-text-muted);
		font-size: var(--dy-text-lg);
		text-wrap: pretty;
	}

	.dy-panels__list {
		margin: 0;
		padding: 0;
		list-style: none;
		font-weight: var(--dy-weight-semibold);
	}

	.dy-panels__list li {
		padding: var(--dy-space-3) 0;
		border-top: var(--dy-border-width) solid var(--dy-color-border-strong);
	}

	.dy-panels__list li:last-child {
		border-bottom: var(--dy-border-width) solid var(--dy-color-border-strong);
	}

	.dy-panels__link {
		align-self: flex-start;
		padding: var(--dy-space-2) 0;
		color: var(--dy-color-text);
		font-weight: var(--dy-weight-semibold);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.dy-panels--cards {
		border-top: 0;
	}

	.dy-panels--cards .dy-panels__inner {
		box-sizing: border-box;
		max-width: var(--dy-width-content);
		margin: 0 auto;
		padding: 0 var(--dy-space-5) var(--dy-space-14);
		gap: var(--dy-space-4);
	}

	.dy-panels--cards .dy-panels__panel,
	.dy-panels--cards .dy-panels__panel + .dy-panels__panel {
		gap: var(--dy-space-3-5);
		padding: var(--dy-space-6) var(--dy-space-5);
		background: var(--dy-color-surface);
		border: var(--dy-border-width) solid var(--dy-color-border);
		border-radius: var(--dy-radius-card-mobile);
	}

	.dy-panels--cards .dy-panels__title {
		font-size: var(--dy-text-heading-mobile);
	}

	.dy-panels--cards .dy-panels__lead {
		font-size: var(--dy-text-base);
	}

	.dy-panels--cards .dy-panels__list li {
		padding: 11px 0;
		border-top-color: var(--dy-color-border);
	}

	.dy-panels--cards .dy-panels__list li:last-child {
		border-bottom: 0;
	}

	.dy-panels--cards .dy-panels__link {
		display: none;
	}

	@media (width >= 1024px) {
		.dy-panels__inner {
			grid-template-columns: 1fr 1fr;
		}

		.dy-panels__long {
			display: inline;
		}

		.dy-panels__short {
			display: none;
		}

		.dy-panels--cards {
			border-top: var(--dy-border-width) solid var(--dy-color-border);
		}

		.dy-panels--cards .dy-panels__inner {
			grid-template-columns: repeat(auto-fit, minmax(min(520px, 100%), 1fr));
			padding: var(--dy-space-26) var(--dy-space-8);
		}

		.dy-panels--cards .dy-panels__panel,
		.dy-panels--cards .dy-panels__panel + .dy-panels__panel {
			gap: var(--dy-space-5);
			padding: clamp(28px, 4vw, 48px);
			border-radius: var(--dy-radius-xl);
		}

		.dy-panels--cards .dy-panels__title {
			font-size: var(--dy-text-display-card);
			line-height: var(--dy-leading-section);
		}

		.dy-panels--cards .dy-panels__lead {
			font-size: var(--dy-text-lead-mobile);
		}

		.dy-panels--cards .dy-panels__list li {
			padding: 13px 0;
		}

		.dy-panels--cards .dy-panels__list li:last-child {
			border-bottom: var(--dy-border-width) solid var(--dy-color-border);
		}

		.dy-panels--cards .dy-panels__link {
			display: block;
			padding: var(--dy-space-1-5) 0;
			color: var(--dy-color-accent);
			text-decoration: none;
		}

		.dy-panels__panel {
			gap: var(--dy-space-6);
			padding: var(--dy-space-20) var(--dy-space-18);
		}

		.dy-panels__title {
			font-size: var(--dy-text-display-lg);
			line-height: var(--dy-leading-display);
		}

		.dy-panels--small .dy-panels__title {
			font-size: var(--dy-text-display-panel);
		}

		.dy-panels__lead {
			font-size: var(--dy-text-xl);
		}
	}
</style>
