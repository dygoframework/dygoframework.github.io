---
// Two side-by-side panels with yellow headings: Security and Performance on
// Home, and the risk and speed panels on Enterprise. They stack below 1024px.
interface Panel {
	id: string;
	title: string;
	lead: string;
	items?: string[];
	link?: { label: string; href: string };
}

interface Props {
	label: string;
	panels: Panel[];
	size?: 'large' | 'small';
}

const { label, panels, size = 'large' } = Astro.props;
---

<section class:list={['dy-panels', `dy-panels--${size}`]} aria-label={label}>
	{
		panels.map((panel) => (
			<div class="dy-panels__panel" id={panel.id}>
				<h2 class="dy-panels__title">{panel.title}</h2>
				<p class="dy-panels__lead">{panel.lead}</p>
				{panel.items && (
					<ul class="dy-panels__list">
						{panel.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				)}
				{panel.link && (
					<a class="dy-panels__link" href={panel.link.href}>
						{panel.link.label}
					</a>
				)}
			</div>
		))
	}
</section>

<style>
	.dy-panels {
		display: grid;
		border-top: var(--dy-border-width) solid var(--dy-color-border);
	}

	.dy-panels__panel {
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-5);
		padding: var(--dy-space-12) var(--dy-space-5);
	}

	.dy-panels__panel + .dy-panels__panel {
		background: var(--dy-color-surface-code);
	}

	.dy-panels__title {
		margin: 0;
		color: var(--dy-color-accent);
		font-size: var(--dy-text-panel-mobile);
		font-weight: var(--dy-weight-extrabold);
		line-height: var(--dy-leading-title);
	}

	.dy-panels--small .dy-panels__title {
		font-size: var(--dy-text-panel-sm-mobile);
	}

	.dy-panels__lead {
		margin: 0;
		color: var(--dy-color-text-muted);
		font-size: var(--dy-text-lg);
		text-wrap: pretty;
	}

	.dy-panels__list {
		margin: 0;
		padding: 0;
		list-style: none;
		font-weight: var(--dy-weight-semibold);
	}

	.dy-panels__list li {
		padding: var(--dy-space-3) 0;
		border-top: var(--dy-border-width) solid var(--dy-color-border-strong);
	}

	.dy-panels__list li:last-child {
		border-bottom: var(--dy-border-width) solid var(--dy-color-border-strong);
	}

	.dy-panels__link {
		align-self: flex-start;
		padding: var(--dy-space-2) 0;
		color: var(--dy-color-text);
		font-weight: var(--dy-weight-semibold);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	@media (width >= 1024px) {
		.dy-panels {
			grid-template-columns: 1fr 1fr;
		}

		.dy-panels__panel {
			gap: var(--dy-space-6);
			padding: var(--dy-space-20) var(--dy-space-18);
		}

		.dy-panels__title {
			font-size: var(--dy-text-display-lg);
			line-height: var(--dy-leading-display);
		}

		.dy-panels--small .dy-panels__title {
			font-size: var(--dy-text-display-panel);
		}

		.dy-panels__lead {
			font-size: var(--dy-text-xl);
		}
	}
</style>
