---
// The benchmark strip under the Home hero. Below 1024px it shows two columns,
// the stats marked `desktopOnly` are left out and `short` labels are used.
interface Stat {
	value: string;
	label: string;
	short?: string;
	desktopOnly?: boolean;
}

interface Props {
	label: string;
	stats: Stat[];
	link?: { label: string; href: string };
}

const { label, stats, link } = Astro.props;
---

<section class="dy-stats" aria-label={label}>
	<div class="dy-stats__inner">
		<dl class="dy-stats__list">
			{
				stats.map((stat) => (
					<div class:list={['dy-stats__item', stat.desktopOnly && 'dy-stats__item--desktop']}>
						<dt class="dy-stats__label">
							{stat.short ? (
								<>
									<span class="dy-stats__long">{stat.label}</span>
									<span class="dy-stats__short">{stat.short}</span>
								</>
							) : (
								stat.label
							)}
						</dt>
						<dd class="dy-stats__value">{stat.value}</dd>
					</div>
				))
			}
		</dl>
		{
			link && (
				<a class="dy-stats__link" href={link.href}>
					{link.label}
				</a>
			)
		}
	</div>
</section>

<style>
	.dy-stats {
		border-block: var(--dy-border-width) solid var(--dy-color-border);
	}

	.dy-stats__inner {
		box-sizing: border-box;
		max-width: var(--dy-width-content);
		margin: 0 auto;
		padding: var(--dy-space-8) var(--dy-space-5);
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--dy-space-5) var(--dy-space-4);
		align-items: end;
	}

	.dy-stats__list {
		display: contents;
	}

	.dy-stats__item {
		display: flex;
		flex-direction: column-reverse;
	}

	.dy-stats__item--desktop,
	.dy-stats__long {
		display: none;
	}

	.dy-stats__value {
		margin: 0;
		font-family: var(--dy-font-mono);
		font-size: var(--dy-text-stat-mobile);
		font-weight: var(--dy-weight-medium);
	}

	.dy-stats__label {
		color: var(--dy-color-text-muted);
		font-size: var(--dy-text-sm);
	}

	.dy-stats__link {
		justify-self: start;
		padding: var(--dy-space-2) 0;
		color: var(--dy-color-accent);
		font-weight: var(--dy-weight-semibold);
		text-decoration: none;
	}

	@media (width >= 1024px) {
		.dy-stats__inner {
			padding: var(--dy-space-10) var(--dy-space-8);
			grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
			gap: var(--dy-space-6) var(--dy-space-8);
		}

		.dy-stats__item--desktop {
			display: flex;
		}

		.dy-stats__long {
			display: inline;
		}

		.dy-stats__short {
			display: none;
		}

		.dy-stats__value {
			font-size: var(--dy-text-stat);
		}

		.dy-stats__label {
			font-size: var(--dy-text-base);
		}

		.dy-stats__link {
			padding: var(--dy-space-2-5) 0;
		}
	}
</style>
