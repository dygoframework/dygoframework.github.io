---
// One labeled example on /styleguide.
interface Props {
	label: string;
	wide?: boolean;
	full?: boolean;
}

const { label, wide = false, full = false } = Astro.props;
---

<figure class:list={['sg-item', { 'sg-item--wide': wide, 'sg-item--full': full }]}>
	<div class="sg-item__demo"><slot /></div>
	<figcaption class="sg-item__label">{label}</figcaption>
</figure>

<style>
	.sg-item {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--dy-space-3);
	}

	.sg-item--wide {
		flex: 1 1 300px;
		max-width: var(--dy-width-form);
	}

	.sg-item--full {
		flex: 1 1 100%;
	}

	.sg-item__label {
		color: var(--dy-color-text-muted);
		font-family: var(--dy-font-mono);
		font-size: var(--dy-text-sm);
	}
</style>
