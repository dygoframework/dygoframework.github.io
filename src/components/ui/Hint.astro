---
// Notes and warnings in docs. Markdown notes use the same markup (see
// scripts/lib/rehype-hint.mjs), so the styles live in src/styles/hint.css.
import '../../styles/hint.css';

interface Props {
	label?: string;
}

const { label = 'Hint' } = Astro.props;
---

<aside class="dy-hint" aria-label={label}>
	<strong class="dy-hint__label">{label}</strong>
	<div class="dy-hint__body"><slot /></div>
</aside>
