---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../components/sections/Hero.astro';
import InstallBox from '../components/sections/InstallBox.astro';
import StatStrip from '../components/sections/StatStrip.astro';
import FamiliarCards from '../components/sections/FamiliarCards.astro';
import SplitPanels from '../components/sections/SplitPanels.astro';
import CodeTabs from '../components/sections/CodeTabs.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import Button from '../components/ui/Button.astro';
import Pill from '../components/ui/Pill.astro';
import { ai, benchmarks, code, cta, familiar, features, hero, install, panels } from '../data/home';
---

<MarketingLayout title="Dygo: a secure, fast Go framework" description={hero.lead}>
	<Hero lead={hero.lead} leadShort={hero.leadShort} size="split">
		<Pill slot="pill" href={hero.pill.href} label={hero.pill.label} text={hero.pill.text} />
		<Fragment slot="title">Secure by default.<br /><span class="dy-hero__accent">Fast by design.</span></Fragment>
		<Fragment slot="actions">{hero.actions.map((a) => <Button href={a.href} variant={a.variant} shape="soft">{a.label}</Button>)}</Fragment>
		<InstallBox commands={install.commands} note={install.note} />
	</Hero>
	<StatStrip label="Benchmarks" stats={benchmarks.stats} link={benchmarks.link} />
	<FamiliarCards id="familiar" title={familiar.title} lead={familiar.lead} items={familiar.items} />
	<SplitPanels label="Security and performance" panels={panels} size="cards" />
	<CodeTabs id="ai" badge={ai.badge} title={ai.title} lead={ai.lead} items={ai.items} link={ai.link} files={ai.files} tabs="sans" label="AI examples" size="md" />
	<FeatureGrid title={features.title} items={features.items} variant="tiles" />
	<CodeTabs id="code" title={code.title} lead={code.lead} link={code.link} files={code.files} hideOnMobile />
	<CallToAction title={cta.title} lead={cta.lead} actions={cta.actions} />
</MarketingLayout>
