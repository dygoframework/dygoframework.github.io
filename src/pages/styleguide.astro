---
import BaseLayout from '../layouts/BaseLayout.astro';
import StyleguideShell from '../components/sections/StyleguideShell.astro';
import StyleguideSection from '../components/sections/StyleguideSection.astro';
import StyleguideItem from '../components/sections/StyleguideItem.astro';
import TokenSwatch from '../components/sections/TokenSwatch.astro';
import TypeSample from '../components/sections/TypeSample.astro';
import Button from '../components/ui/Button.astro';
import Input from '../components/ui/Input.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import CodeBlock from '../components/ui/CodeBlock.astro';
import Hint from '../components/ui/Hint.astro';
import Icon from '../components/ui/Icon.astro';
import Logo from '../components/ui/Logo.astro';
import Pill from '../components/ui/Pill.astro';
import OptionGroup from '../components/ui/OptionGroup.astro';
import TopBar from '../components/navigation/TopBar.astro';
import Sidebar from '../components/navigation/Sidebar.astro';
import MobileMenu from '../components/navigation/MobileMenu.astro';
import OnThisPage from '../components/navigation/OnThisPage.astro';
import SearchField from '../components/navigation/SearchField.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import { colorTokens, typeTokens } from '../data/styleguide';
---

<BaseLayout title="Styleguide | Dygo" description="Every shared token and component, with its states." noindex>
	<TopBar />
	<MobileMenu currentPath="/styleguide/" />
	<main id="main">
		<StyleguideShell title="Styleguide">
			<StyleguideSection title="Colors" id="colors">
				{colorTokens.map((token) => <TokenSwatch token={token} />)}
			</StyleguideSection>

			<StyleguideSection title="Type" id="type">
				{typeTokens.map((token) => <TypeSample token={token} />)}
				<TypeSample token="--dy-text-md" mono />
			</StyleguideSection>

			<StyleguideSection title="Button" id="button">
				<StyleguideItem label="primary"><Button>Get started</Button></StyleguideItem>
				<StyleguideItem label="primary, hover"><Button state="hover">Get started</Button></StyleguideItem>
				<StyleguideItem label="primary, focus"><Button state="focus">Get started</Button></StyleguideItem>
				<StyleguideItem label="primary, disabled"><Button disabled>Get started</Button></StyleguideItem>
				<StyleguideItem label="primary, loading"><Button loading loadingLabel="Sending">Get in touch</Button></StyleguideItem>
				<StyleguideItem label="primary, link"><Button href="#button">Get started</Button></StyleguideItem>
				<StyleguideItem label="secondary"><Button variant="secondary">GitHub</Button></StyleguideItem>
				<StyleguideItem label="primary, soft"><Button shape="soft">Get started</Button></StyleguideItem>
				<StyleguideItem label="secondary, soft"><Button variant="secondary" shape="soft">Start a project</Button></StyleguideItem>
				<StyleguideItem label="secondary, hover"><Button variant="secondary" state="hover">GitHub</Button></StyleguideItem>
				<StyleguideItem label="secondary, focus"><Button variant="secondary" state="focus">GitHub</Button></StyleguideItem>
				<StyleguideItem label="secondary, disabled"><Button variant="secondary" disabled>GitHub</Button></StyleguideItem>
				<StyleguideItem label="primary, rounded"><Button shape="rounded">Get in touch</Button></StyleguideItem>
				<StyleguideItem label="tool"><Button variant="tool"><Icon name="copy" size="sm" />Copy markdown</Button></StyleguideItem>
				<StyleguideItem label="tool, hover"><Button variant="tool" state="hover"><Icon name="copy" size="sm" />Copy markdown</Button></StyleguideItem>
				<StyleguideItem label="tool, focus"><Button variant="tool" state="focus"><Icon name="copy" size="sm" />Copy markdown</Button></StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="Input" id="input">
				<StyleguideItem label="default" wide>
					<Input id="sg-email" label="Work email" type="email" placeholder="you@company.com" autocomplete="email" />
				</StyleguideItem>
				<StyleguideItem label="hover" wide>
					<Input id="sg-email-hover" label="Work email" type="email" placeholder="you@company.com" state="hover" />
				</StyleguideItem>
				<StyleguideItem label="focus" wide>
					<Input id="sg-email-focus" label="Work email" type="email" placeholder="you@company.com" state="focus" />
				</StyleguideItem>
				<StyleguideItem label="with hint" wide>
					<Input id="sg-email-hint" label="Work email" type="email" hint="We only use it to reply to you." />
				</StyleguideItem>
				<StyleguideItem label="error" wide>
					<Input id="sg-email-error" label="Work email" type="email" value="you@" error="Enter a valid email address." />
				</StyleguideItem>
				<StyleguideItem label="disabled" wide>
					<Input id="sg-email-disabled" label="Work email" type="email" placeholder="you@company.com" disabled />
				</StyleguideItem>
				<StyleguideItem label="code" wide>
					<Input id="sg-project-name" label="Project name" value="shop" hint="Lowercase letters, numbers and dashes." variant="code" />
				</StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="OptionGroup" id="option-group">
				<StyleguideItem label="one chosen" wide>
					<OptionGroup legend="Database" name="styleguide-db" value="postgres" options={[{ value: 'none', label: 'None', hint: 'In memory to start' }, { value: 'postgres', label: 'PostgreSQL', hint: 'With migrations' }, { value: 'mysql', label: 'MySQL', hint: 'With migrations' }]} />
				</StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="Logo and icons" id="logo">
				<StyleguideItem label="Logo"><Logo /></StyleguideItem>
				<StyleguideItem label="Logo, small"><Logo size="sm" /></StyleguideItem>
				<StyleguideItem label="Icon: menu, close, search, chevron, copy, check">
					<span>
						<Icon name="menu" /><Icon name="close" /><Icon name="search" /><Icon name="chevron" /><Icon name="copy" /><Icon name="check" />
					</span>
				</StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="Badge" id="badge">
				<StyleguideItem label="soon"><Badge>Soon</Badge></StyleguideItem>
				<StyleguideItem label="accent, xs (docs menu)"><Badge variant="accent" size="xs">Beta</Badge></StyleguideItem>
				<StyleguideItem label="accent, sm (feature card)"><Badge variant="accent" size="sm">Beta</Badge></StyleguideItem>
				<StyleguideItem label="accent, md (pill)"><Badge variant="accent" size="md">New</Badge></StyleguideItem>
				<StyleguideItem label="accent, lg (section)"><Badge variant="accent" size="lg">Beta</Badge></StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="Pill" id="pill">
				<StyleguideItem label="default"><Pill href="#pill" label="New" text="Example announcement" /></StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="Card" id="card">
				<StyleguideItem label="outline, link" wide><Card href="#card" title="Quick start" description="Build your first service." /></StyleguideItem>
				<StyleguideItem label="outline, hover" wide><Card href="#card" title="Quick start" description="Build your first service." state="hover" /></StyleguideItem>
				<StyleguideItem label="outline, focus" wide><Card href="#card" title="Quick start" description="Build your first service." state="focus" /></StyleguideItem>
				<StyleguideItem label="rounded, previous" wide><Card variant="rounded" href="#card" eyebrow="Previous" title="Introduction" /></StyleguideItem>
				<StyleguideItem label="rounded, next" wide><Card variant="rounded" align="end" href="#card" eyebrow="Next" title="Controllers" /></StyleguideItem>
				<StyleguideItem label="feature" wide><Card variant="feature" title="Typed handlers" description="Example text for the styleguide." /></StyleguideItem>
				<StyleguideItem label="panel" wide><Card variant="panel" title="Workshops" description="Example text for the styleguide." /></StyleguideItem>
				<StyleguideItem label="tile" wide><Card variant="tile" title="Typed handlers" description="Example text for the styleguide." /></StyleguideItem>
				<StyleguideItem label="tile, badge" wide><Card variant="tile" title="AI" description="Example text for the styleguide." badge="Beta" /></StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="Hint" id="hint">
				<StyleguideItem label="default" wide>
					<Hint>Example note text. Run <code>go version</code> to check yours.</Hint>
				</StyleguideItem>
				<StyleguideItem label="warning label" wide>
					<Hint label="Warning">Example warning text for the styleguide.</Hint>
				</StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="CodeBlock" id="codeblock">
				<StyleguideItem label="file name and language" wide>
					<CodeBlock lang="go" title="main.go" code={'package main\n\nimport "fmt"\n\nfunc main() {\n\tfmt.Println("hello")\n}'} />
				</StyleguideItem>
				<StyleguideItem label="terminal" wide>
					<CodeBlock lang="bash" code="go run ." />
				</StyleguideItem>
				<StyleguideItem label="plain, inset" wide>
					<CodeBlock variant="plain" inset lang="go" code={'func main() {\n\tfmt.Println("hello")\n}'} />
				</StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="TopBar" id="topbar">
				<StyleguideItem label="marketing, Enterprise current" full><TopBar current="enterprise" /></StyleguideItem>
				<StyleguideItem label="docs, with search and version" full>
					<TopBar variant="docs" version="v1.0.0-beta.1" sidebarId="sg-sidebar"><SearchField slot="search" searchable /></TopBar>
				</StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="SiteFooter" id="footer">
				<StyleguideItem label="full" full><SiteFooter /></StyleguideItem>
				<StyleguideItem label="simple" full><SiteFooter variant="simple" /></StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="SearchField" id="search">
				<StyleguideItem label="bar" wide><SearchField searchable /></StyleguideItem>
				<StyleguideItem label="menu" wide><SearchField variant="menu" searchable /></StyleguideItem>
				<StyleguideItem label="link to docs" wide><SearchField variant="menu" /></StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="Sidebar" id="sidebar">
				<StyleguideItem label="card, First steps current" wide><Sidebar currentPath="/docs/first-steps/" id="sg-sidebar" /></StyleguideItem>
				<StyleguideItem label="card, Security open, Soon item" wide><Sidebar currentPath="/docs/security/cors/" id="sg-sidebar-security" /></StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="MobileMenu" id="mobile-menu">
				<StyleguideItem label="open"><MobileMenu currentPath="/docs/first-steps/" preview /></StyleguideItem>
			</StyleguideSection>

			<StyleguideSection title="OnThisPage" id="on-this-page">
				<StyleguideItem label="aside" wide>
					<OnThisPage
						id="sg-toc"
						title="First steps"
						editUrl="https://github.com/dygoframework/dygo"
						headings={[{ depth: 2, slug: 'colors', text: 'Colors' }, { depth: 2, slug: 'type', text: 'Type' }, { depth: 3, slug: 'button', text: 'Button' }]}
					/>
				</StyleguideItem>
				<StyleguideItem label="collapsible" wide>
					<OnThisPage
						id="sg-toc-box"
						variant="collapsible"
						title="First steps"
						headings={[{ depth: 2, slug: 'colors', text: 'Colors' }, { depth: 2, slug: 'type', text: 'Type' }]}
					/>
				</StyleguideItem>
			</StyleguideSection>
		</StyleguideShell>
	</main>
</BaseLayout>
